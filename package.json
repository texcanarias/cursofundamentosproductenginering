{
  "name": "a-la-par",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "test:gherkin": "cucumber-js --config cucumber.cjs",
    "brand:icons": "node scripts/generate-brand-icons.mjs",
    "lint": "ng lint",
    "format": "prettier --write \"src/**/*.{ts,html,scss}\" \"e2e/**/*.cjs\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss}\" \"e2e/**/*.cjs\" \"scripts/**/*.mjs\"",
    "start:prod": "ng serve --configuration production",
    "dev:back": "npm --prefix back run dev",
    "start:back": "npm --prefix back run start",
    "build:back": "npm --prefix back run build",
    "test:back": "npm --prefix back test",
    "lint:back": "npm --prefix back run lint",
    "format:back": "npm --prefix back run format",
    "format:back:check": "npm --prefix back run format:check"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.6.0",
    "express": "^5.1.0",
    "@angular/cdk": "^22.2.5",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/material": "^22.2.5",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/service-worker": "^22.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.0",
    "@axe-core/playwright": "^4.14.0",
    "@cucumber/cucumber": "^13.3.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "angular-eslint": "22.6.0",
    "eslint": "^10.12.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.71.0",
    "vitest": "^5.0.0"
  }
}