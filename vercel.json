{
  "version": 2,
  "framework": null,
  "buildCommand": "npm --prefix front run build",
  "outputDirectory": "front/dist/front/browser",
  "functions": {
    "api/index.ts": {
      "runtime": "nodejs24.x"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" }
  ],
  "env": {
    "LOTES_CSV_PATH": "/tmp/lotes.csv",
    "ENTREGAS_CSV_PATH": "/tmp/entregas.csv",
    "NODE_ENV": "production"
  }
}