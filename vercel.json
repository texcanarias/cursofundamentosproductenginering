{
  "version": 2,
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist/front/browser",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" }
  ],
  "env": {
    "LOTES_CSV_PATH": "back/data/lotes.csv",
    "ENTREGAS_CSV_PATH": "back/data/entregas.csv",
    "NODE_ENV": "production"
  }
}