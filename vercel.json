{
  "version": 2,
  "framework": null,
  "buildCommand": "bash scripts/vercel-build.sh",
  "outputDirectory": "dist/front/browser",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" }
  ],
  "env": {
    "LOTES_CSV_PATH": "/tmp/lotes.csv",
    "ENTREGAS_CSV_PATH": "/tmp/entregas.csv",
    "NODE_ENV": "production"
  }
}
